<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity GameProgress.
    -->
    <changeSet id="20260920173901-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="game_id"
                                 baseTableName="game_progress"
                                 constraintName="fk_game_progress__game_id"
                                 referencedColumnNames="id"
                                 referencedTableName="game"
                                 />

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="game_progress"
                                 constraintName="fk_game_progress__user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="user_profile"
                                 />

        <addForeignKeyConstraint baseColumnNames="user_profile_id"
                                 baseTableName="game_progress"
                                 constraintName="fk_game_progress__user_profile_id"
                                 referencedColumnNames="id"
                                 referencedTableName="user_profile"
                                 />
    </changeSet>
</databaseChangeLog>
