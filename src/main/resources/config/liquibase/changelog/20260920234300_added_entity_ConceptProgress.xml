<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity ConceptProgress.
    -->
    <changeSet id="20260920234300-1" author="jhipster">
        <createTable tableName="concept_progress">
            <column name="id" type="bigint" autoIncrement="true" startWith="1500">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="competency" type="${floatType}">
                <constraints nullable="false" />
            </column>
            <column name="improvement" type="${floatType}">
                <constraints nullable="false" />
            </column>
            <column name="last_practiced_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="max_questions" type="integer">
                <constraints nullable="false" />
            </column>
            <column name="user_profile_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="concept_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="concept_progress" columnName="last_practiced_at" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
