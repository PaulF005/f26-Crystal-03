<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Scenario.
    -->
    <changeSet id="20260916023749-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="topic_id"
                                 baseTableName="scenario"
                                 constraintName="fk_scenario__topic_id"
                                 referencedColumnNames="id"
                                 referencedTableName="topic"
                                 />

        <addForeignKeyConstraint baseColumnNames="starting_stage_id"
                                 baseTableName="scenario"
                                 constraintName="fk_scenario__starting_stage_id"
                                 referencedColumnNames="id"
                                 referencedTableName="stage"
                                 />

        <addForeignKeyConstraint baseColumnNames="game_id"
                                 baseTableName="scenario"
                                 constraintName="fk_scenario__game_id"
                                 referencedColumnNames="id"
                                 referencedTableName="game"
                                 />
    </changeSet>
</databaseChangeLog>
