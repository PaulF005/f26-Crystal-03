<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261102000100-2" author="kip">

        <addUniqueConstraint
            tableName="question_history"
            columnNames="user_profile_id, question_id"
            constraintName="ux_question_history_player_question"/>

        <addForeignKeyConstraint
            baseTableName="question_history"
            baseColumnNames="user_profile_id"
            referencedTableName="user_profile"
            referencedColumnNames="id"
            constraintName="fk_question_history_player"/>

        <addForeignKeyConstraint
            baseTableName="question_history"
            baseColumnNames="question_id"
            referencedTableName="question"
            referencedColumnNames="id"
            constraintName="fk_question_history_question"/>

    </changeSet>
</databaseChangeLog>