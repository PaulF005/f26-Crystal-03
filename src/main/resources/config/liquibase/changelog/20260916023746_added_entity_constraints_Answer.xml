<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Answer.
    -->
    <changeSet id="20260916023746-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="next_stage_id"
                                 baseTableName="answer"
                                 constraintName="fk_answer__next_stage_id"
                                 referencedColumnNames="id"
                                 referencedTableName="stage"
                                 />

        <addForeignKeyConstraint baseColumnNames="feedback_id"
                                 baseTableName="answer"
                                 constraintName="fk_answer__feedback_id"
                                 referencedColumnNames="id"
                                 referencedTableName="feedback"
                                 />

        <addForeignKeyConstraint baseColumnNames="question_id"
                                 baseTableName="answer"
                                 constraintName="fk_answer__question_id"
                                 referencedColumnNames="id"
                                 referencedTableName="question"
                                 />
    </changeSet>
</databaseChangeLog>
