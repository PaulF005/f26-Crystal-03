<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260916023744-1" author="jhipster">
        <createTable tableName="concept">
            <column name="id" type="bigint" autoIncrement="true" startWith="1500">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="explanation" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="topic_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="legal_content_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>

    <changeSet id="20260916023744-1-data" author="rachel" context="faker">
        <loadData
            file="config/liquibase/fake-data/concept.csv"
            separator=";"
            tableName="concept">
            <column name="id" type="numeric"/>
            <column name="name" type="string"/>
            <column name="explanation" type="string"/>
            <column name="topic_id" type="numeric"/>
            <column name="legal_content_id" type="numeric"/>
        </loadData>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
