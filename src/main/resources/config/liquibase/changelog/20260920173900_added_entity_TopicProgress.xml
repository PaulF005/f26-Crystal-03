<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260920173900-1" author="jhipster">
        <createTable tableName="topic_progress">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="competency" type="float">
                <constraints nullable="false" />
            </column>
            <column name="improvement" type="float">
                <constraints nullable="false" />
            </column>
            <column name="last_practiced_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="user_profile_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="topic_id" type="bigint">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <!-- Semicolon Data Loader Configuration -->
    <changeSet id="20260920173900-1-data" author="rachel" context="faker">
        <loadData
                  file="config/liquibase/fake-data/topic_progress.csv"
                  separator=";"
                  tableName="topic_progress">
            <column name="id" type="numeric"/>
            <column name="competency" type="numeric"/>
            <column name="improvement" type="numeric"/>
            <column name="last_practiced_at" type="datetime"/>
            <column name="user_profile_id" type="numeric"/>
            <column name="topic_id" type="numeric"/>
        </loadData>
    </changeSet>
</databaseChangeLog>
