<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261102000300-1" author="kip">

        <!-- Game types -->
        <loadData
            file="config/liquibase/data/game.csv"
            separator=";"
            encoding="UTF-8"
            tableName="game">
            <column header="id" name="id" type="NUMERIC"/>
            <column header="name" name="name" type="STRING"/>
        </loadData>

        <!-- Learning topics -->
        <loadData
            file="config/liquibase/data/topic.csv"
            separator=";"
            encoding="UTF-8"
            tableName="topic">
            <column header="id" name="id" type="NUMERIC"/>
            <column header="name" name="name" type="STRING"/>
            <column header="explanation" name="explanation" type="STRING"/>
        </loadData>

        <!-- Question categories -->
        <loadData
            file="config/liquibase/data/concept.csv"
            separator=";"
            encoding="UTF-8"
            tableName="concept">
            <column header="id" name="id" type="NUMERIC"/>
            <column header="name" name="name" type="STRING"/>
            <column header="explanation" name="explanation" type="STRING"/>
            <column header="topic_id" name="topic_id" type="NUMERIC"/>
        </loadData>

        <!-- Reference sources -->
        <loadData
            file="config/liquibase/data/source.csv"
            separator=";"
            encoding="UTF-8"
            tableName="source">
            <column header="id" name="id" type="NUMERIC"/>
            <column header="name" name="name" type="STRING"/>
            <column header="url" name="url" type="STRING"/>
            <column header="retrieved" name="date" type="STRING"/>
            <column header="data" name="data" type="STRING"/>
        </loadData>

    </changeSet>
</databaseChangeLog>