<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261102000500-2" author="kip">
        <addForeignKeyConstraint baseTableName="fof_presentation" baseColumnNames="user_profile_id"
            referencedTableName="user_profile" referencedColumnNames="id" constraintName="fk_fof_presentation_player"/>
        <addForeignKeyConstraint baseTableName="fof_presentation" baseColumnNames="question_id"
            referencedTableName="fof_question" referencedColumnNames="question_id" constraintName="fk_fof_presentation_question"/>
        <addForeignKeyConstraint baseTableName="fof_presentation" baseColumnNames="selected_answer_id"
            referencedTableName="answer" referencedColumnNames="id" constraintName="fk_fof_presentation_answer"/>
        <createIndex tableName="fof_presentation" indexName="idx_fof_presentation_session">
            <column name="engine_session_id"/>
            <column name="user_profile_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
