application {
  config {
    baseName kip
    applicationType monolith
    packageName com.crystal.kip
    authenticationType jwt
    prodDatabaseType mysql
    devDatabaseType mysql
    clientFramework angular
  }
  entities *
}

entity UserDetail {
  username String required
  email String required
}

entity ConceptProgress {
  competency Float required min(0) max(1)
  improvement Float required
  evidenceCount Integer required min(0)
  lastPracticedAt Instant required
}

entity GameProgress {
  sessionsPlayed Integer required min(0)
  performance Float required min(0) max(1)
  evidenceCount Integer required min(0)
  lastPlayedAt Instant required
}

entity GameSession {
  startedAt Instant required
  completedAt Instant required
}

entity StageAttempt {
  startedAt Instant required
  completedAt Instant required
}

entity Topic {
  name String required
  explanation String
}

entity Concept {
  name String required
  explanation String
}

entity Question {
  question String required
}

entity Answer {
  text String required
  outcomeText String
  correct Boolean required
  terminalResolution ScenarioResolution
}

enum ScenarioResolution {
  POSITIVE, 
  NEGATIVE, 
  INCONCLUSIVE
}

entity Feedback {
  feedback String required
  explanation String
}

entity Game {
  name String required
}

entity Scenario {
  name String required
}

entity Stage {}

entity LegalContent {
  name String required
}

entity Source {
  name String required
  url String
  date String
  data String required
}

relationship OneToOne {
  UserDetail{dataUser} to User with builtInEntity
}

relationship OneToMany {
  UserDetail to ConceptProgress{userProfile}
  UserDetail to GameProgress{userProfile}
  UserDetail to GameSession{user}
  
  Game to Scenario{game}
  Game to GameSession{game}
  GameSession to StageAttempt{gameSession}
  
  Scenario to Stage{scenario}
  Topic to Concept{topic}
  Concept to Question{concept}
  Concept to ConceptProgress{concept}
  Question to Answer{question}
}

relationship ManyToOne {
  Source{legalContent} to LegalContent
  Concept{legalContent} to LegalContent
  Scenario{topic} to Topic
  Stage{question} to Question
  Answer{nextStage} to Stage
  Answer{feedback} to Feedback
}
