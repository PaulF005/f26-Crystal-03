application {
  config {
    baseName kip
    applicationType monolith
    packageName com.crystal.kip
    authenticationType jwt
    prodDatabaseType mysql
    devDatabaseType mysql
    clientFramework angular
    skipFakeData true
  }
  entities *
}

entity UserProfile {
  username String required
  email String required
}

entity ConceptProgress {
  competency Float required min(0) max(1)
  improvement Float required
  evidenceCount Integer required min(0)
  lastPracticedAt Instant required
}

entity TopicProgress {
  competency Float required min(0) max(1)
  improvement Float required
  evidenceCount Integer required min(0)
  lastPracticedAt Instant required
}

entity GameProgress {
  sessionsPlayed Integer required min(0)
  performance Float required min(0) max(1)
  evidenceCount Integer required min(0)
  lastPlayedAt Instant required
}

entity GameSession {
  startedAt Instant required
  completedAt Instant required
}

entity StageAttempt {
  answeredAt Instant required
  correct Boolean required
}

entity Topic {
  name String required
  explanation String
}

entity Concept {
  name String required
  explanation String
}

entity Question {
  question String required
}

entity Answer {
  text String required
  outcomeText String
  correct Boolean required
  terminalResolution ScenarioResolution
}

enum ScenarioResolution {
  POSITIVE,
  NEGATIVE,
  INCONCLUSIVE
}

entity Feedback {
  feedback String required
  explanation String
}

entity Game {
  name String required
}

entity Scenario {
  name String required
}

entity Stage {}

entity LegalContent {
  name String required
}

entity Source {
  name String required
  url String
  date String
  data String required
}

relationship OneToOne {
  UserProfile{dataUser} to User with builtInEntity
}

relationship OneToMany {
  UserProfile{topicProgresses} to TopicProgress{userProfile required}
  UserProfile{gameProgresses} to GameProgress{userProfile required}
  UserProfile{conceptProgresses} to ConceptProgress{userProfile}

  GameSession{stageAttempt} to StageAttempt{gameSession required}

  Scenario{stage} to Stage{scenario required}
  Topic{concept} to Concept{topic}
  Concept{question} to Question{concept required}
  Concept{conceptProgresses} to ConceptProgress{concept}
  Question{answer} to Answer{question}
}

relationship ManyToOne {
  GameProgress{game required} to Game
  TopicProgress{topic required} to Topic

  GameSession{user required} to UserProfile
  GameSession{game required} to Game

  StageAttempt{user} to UserProfile
  StageAttempt{stage} to Stage
  StageAttempt{selectedAnswer} to Answer

  Source{legalContent} to LegalContent
  Concept{legalContent} to LegalContent

  Scenario{topic required} to Topic
  Scenario{startingStage required} to Stage
  Scenario{game required} to Game

  Stage{question required} to Question

  Answer{nextStage} to Stage
  Answer{feedback} to Feedback
}