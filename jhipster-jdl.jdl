
application {
  config {
    baseName kip
    applicationType monolith
    packageName com.crystal.kip
    authenticationType jwt
    prodDatabaseType mysql
    devDatabaseType mysql
    clientFramework angular
  }
  entities *
}

entity UserDetail {
	username String required
    email String required
}

entity Progress {
	moduleCompletion Float required
}

entity Module {
	name String required
}

entity Topic {
	name String required
    explanation String
}

entity Question {
	question String required
}

entity LegalContent {
	name String required
}

entity Source {
	name String required
    url String
    date String 
    data String required
}

relationship OneToOne {
	UserDetail{dataUser} to User with builtInEntity
}
relationship OneToMany {
  	UserDetail to Progress{user}
}

relationship ManyToOne {
  	Progress{module} to Module
}

relationship OneToMany {
  	Module to Topic{module}
}

relationship OneToMany {
 	Topic to Question{topic}
}

relationship ManyToOne {
	Topic{legalContent} to LegalContent
}

relationship OneToMany {
	LegalContent to Source{legalContent}
}